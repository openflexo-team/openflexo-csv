<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector"
       layout="border"
       titleFont="SansSerif,0,12"
       darkLevel="0"
       dataClassName="org.openflexo.ta.csv.fml.editionaction.AbstractSelectCSVRow"
       controllerClassName="org.openflexo.fml.controller.FMLFIBInspectorController"
       font="SansSerif,0,12"
       name="Inspector">

    <TabPanel name="Tab" constraints="border(location=center)">
        <Tab title="Basic"
             layout="twocols"
             titleFont="SansSerif,0,11"
             darkLevel="0"
             index="0"
             font="SansSerif,0,11"
             useScrollBar="true"
             horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
             verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
             name="BasicTab">

            <!-- CSV Document binding -->
            <Label label="document"
                   align="right"
                   index="4"
                   data=""
                   constraints="twocols(expandHorizontally=true;expandVertically=false;index=4;insetsBottom=0;insetsLeft=2;insetsRight=4;insetsTop=5;location=left)"
                   visible=""
                   format=""
                   icon=""
                   tooltip=""
                   localize="true"
                   enable=""
                   clickAction=""
                   doubleClickAction=""
                   rightClickAction=""
                   enterPressedAction=""
                   valueChangedAction=""
                   valueTransform=""
                   valueValidator=""/>
            <Custom componentClassName="org.openflexo.gina.swing.utils.BindingSelector"
                    format=""
                    icon=""
                    tooltip=""
                    localize="true"
                    enable=""
                    manageDynamicModel="true"
                    opaque="false"
                    clickAction=""
                    doubleClickAction=""
                    rightClickAction=""
                    enterPressedAction=""
                    valueChangedAction=""
                    valueTransform=""
                    valueValidator=""
                    index="4"
                    data="data.csvDocument"
                    constraints="twocols(expandHorizontally=true;expandVertically=false;index=4;insetsBottom=0;insetsLeft=2;insetsRight=2;insetsTop=0;location=right)"
                    visible="">
                <Assignment variable="component.bindable" value="data"/>
            </Custom>
        </Tab>
    </TabPanel>

    <LocalizedDictionary>
        <Localized key="Advanced" lang="French" value="Avancé"/>
        <Localized key="Basic" lang="French" value="Basique"/>
        <Localized key="document" lang="French" value="document"/>
    </LocalizedDictionary>

    <Parameter name="title" value="SelectCSVRow action"/>
</Panel>