<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector"
       layout="border"
       titleFont="SansSerif,0,12"
       darkLevel="0"
       dataClassName="org.openflexo.ta.csv.CSVModelSlot"
       controllerClassName="org.openflexo.fml.controller.FMLFIBInspectorController"
       font="SansSerif,0,12"
       name="Inspector">

    <TabPanel name="Tab" constraints="border(location=center)">
        <Tab title="Basic"
             layout="twocols"
             titleFont="SansSerif,0,11"
             darkLevel="0"
             index="0"
             font="SansSerif,0,11"
             useScrollBar="true"
             horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
             verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
             name="BasicTab">

            <!-- Model slot name -->
            <Label label="name"
                   index="0"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=0;location=left)"
                   name="NameLabel"
                   localize="true"/>
            <TextField index="1"
                       data="data.name"
                       constraints="twocols(expandHorizontally=true;expandVertically=false;index=1;location=right)"
                       name="Name"
                       localize="true"
                       columns="10"/>

            <!-- Required flag -->
            <Label label="required"
                   index="2"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
                   name="RequiredLabel"
                   localize="true"/>
            <CheckBox index="3"
                      data="data.isRequired"
                      constraints="twocols(expandHorizontally=false;expandVertically=false;index=3;location=right)"
                      name="Required"/>
        </Tab>

        <Tab title="Advanced"
             layout="twocols"
             titleFont="SansSerif,0,11"
             darkLevel="0"
             index="2"
             font="SansSerif,0,11"
             useScrollBar="true"
             horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
             verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
             name="AdvancedTab"/>
    </TabPanel>

    <LocalizedDictionary>
        <Localized key="Advanced" lang="French" value="Avancé"/>
        <Localized key="Basic" lang="French" value="Basique"/>
        <Localized key="name" lang="French" value="nom"/>
        <Localized key="required" lang="French" value="requis"/>
    </LocalizedDictionary>

    <Parameter name="title" value="CSV ModelSlot"/>
</Panel>