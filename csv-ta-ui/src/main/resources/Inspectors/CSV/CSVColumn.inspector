<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector"
       layout="border"
       titleFont="SansSerif,0,12"
       darkLevel="0"
       dataClassName="org.openflexo.ta.csv.model.CSVColumn"
       controllerClassName="org.openflexo.inspector.FIBInspectorController"
       font="SansSerif,0,12"
       name="Inspector">

    <TabPanel name="Tab" constraints="border(location=center)">
        <Tab title="Basic"
             layout="twocols"
             titleFont="SansSerif,0,11"
             darkLevel="0"
             index="0"
             font="SansSerif,0,11"
             useScrollBar="true"
             horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
             verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED"
             name="BasicTab">

            <!-- Column name -->
            <Label label="name"
                   index="0"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=0;location=left)"
                   name="NameLabel"
                   localize="true"/>
            <TextField index="1"
                       data="data.name"
                       constraints="twocols(expandHorizontally=true;expandVertically=false;index=1;location=right)"
                       name="Name"
                       readOnly="true"
                       localize="true"
                       columns="15"/>

            <!-- Column index -->
            <Label label="column_index"
                   index="2"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=2;location=left)"
                   name="ColumnIndexLabel"
                   localize="true"/>
            <Number index="3"
                    data="data.columnIndex"
                    constraints="twocols(expandHorizontally=false;expandVertically=false;index=3;location=right)"
                    name="ColumnIndex"
                    readOnly="true"
                    numberType="IntegerType"
                    columns="5"/>

            <!-- Data type -->
            <Label label="data_type"
                   index="4"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=4;location=left)"
                   name="DataTypeLabel"
                   localize="true"/>
            <TextField index="5"
                       data="data.dataType"
                       constraints="twocols(expandHorizontally=true;expandVertically=false;index=5;location=right)"
                       name="DataType"
                       readOnly="true"
                       localize="true"
                       columns="10"/>

            <!-- Parent document -->
            <Label label="document"
                   index="6"
                   constraints="twocols(expandHorizontally=false;expandVertically=false;index=6;location=left)"
                   name="DocumentLabel"
                   localize="true"/>
            <TextField index="7"
                       data="data.getCSVDocument().resource.name"
                       constraints="twocols(expandHorizontally=true;expandVertically=false;index=7;location=right)"
                       name="Document"
                       readOnly="true"
                       localize="true"
                       columns="15"/>
        </Tab>
    </TabPanel>

    <LocalizedDictionary>
        <Localized key="Basic" lang="French" value="Basique"/>
        <Localized key="name" lang="French" value="nom"/>
        <Localized key="column_index" lang="French" value="index de colonne"/>
        <Localized key="data_type" lang="French" value="type de données"/>
        <Localized key="document" lang="French" value="document"/>
    </LocalizedDictionary>

    <Parameter name="title" value="CSV Column"/>
</Panel>
