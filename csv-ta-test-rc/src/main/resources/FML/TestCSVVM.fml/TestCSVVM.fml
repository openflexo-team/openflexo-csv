/**
 * Build a sequential graph from printer actions
 */
public DictionaryGraph buildSequentialGraph() {
    List<PrinterAction> actions = new ArrayList<>();
    for (PrinterAction action : actionsInstances) { //change later to get the current instances of the PrinterActions
        actions.add(action);
    }

    this.sortPrinterActions(actions);
    log "sorted data";
    for (PrinterAction action : actions) {
        log "Action Sort" + action;
    }
    Map<Object,List<Object>> graph = new HashMap<>(); // change later to init an actual hashmap
    List<Object> roots = new ArrayList<>();

    if (!actions.isEmpty()) {
        roots.add(actions.get(0));
        Integer i = 0;

        //cuz the last action will have no neighbors (unless there's a cycle we'll have to look into that later)
        graph.put(actions.get(actions.size() - 1),new ArrayList<>());
    }

    DictionaryGraph seqGraph = new DictionaryGraph(roots,graph);
    log "Sequential graph built with " + actions.size() + " nodes";

    return seqGraph;
}
//========================================================================================================================================
/**
 * Breadth-first search on a RootedGraph with callback
 */
public SearchResult searchRG(RootedGraph graph, OnEntryCallback onEntry) {
    log "WE IN ================";
    Set<Object> known = new HashSet<>();
    Deque<Object> frontier = new ArrayDeque<>();
    Map<String,Object> opaqueData = new HashMap<>(); //change later with new HashMap<>()

    for (Object r : parameters.graph.roots()) {
        if (!known.contains(r)) {
            log "this is the first Condition : " + parameters.onEntry.onEntry(r,opaqueData);
            if (parameters.onEntry.onEntry(r,opaqueData)) {
                log "First sortie : " + r;
                return new SearchResult(r,true);
            }
            known.add(r);
            frontier.add(r);
        }
    }

    while (!frontier.isEmpty()) {
        Object curr = frontier.removeFirst();
        for (Object n : parameters.graph.neighbors(curr)) {
            if (!known.contains(n)) {
                log "this is the second Condition : " + parameters.onEntry.onEntry(n,opaqueData);

                if (parameters.onEntry.onEntry(n,opaqueData)) {
                    log "Second sortie : " + n;
                    return new SearchResult(n,true);
                }
                known.add(n);
                frontier.add(n);
            }
        }
    }

    log "default sortie : null ";
    return new SearchResult(null,false);
}
//========================================================================================================================================
/**
 * Reconstruct path from roots to target using parent tracer
 */
public List<Object> reconstructPath(ParentTracer tracer, Object target) {
    Map<Object,List<Object>> parents = parameters.tracer.getParents();

    if (!parents.containsKey(parameters.target)) {
        return new ArrayList<>();
    }

    List<Object> path = new ArrayList<>();
    path.add(parameters.target);
    this.buildPath(path,parameters.target,parents);

    // Collections.reverse(path); //(uncomment this line in tests)
    return path;
}

/**
 * Recursively build path by traversing parent relationships
 */
public int buildPath(List<Object> path, Object current, Map<Object,List<Object>> parents) {
    if (!parameters.parents.containsKey(parameters.current)) {
        return 0;
    }

    List<Object> parentList = parameters.parents.getOrDefault(parameters.current,new ArrayList<>());
    if (parentList == null || parentList.isEmpty()) {
        return 0;
    }

    for (Object parent : parentList) {
        parameters.path.add(parent);
        this.buildPath(parameters.path,parent,parameters.parents);
    }
}
