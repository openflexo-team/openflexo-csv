            String actionP= row.getCellAt(1).value;
            Integer sequenceId = tmpRow.rowIndex ;
            log "Assined vars seqId :" + sequenceId + ":  Action " + actionP + "@TimeStamp " + timeStamp + "";
        }
        public void getActions(){
