/**
 * Callback to find a specific action by name
 */
public concept FindAction extends OnEntryCallback {
    private String targetAction;

    create(String act) {
        this.targetAction = parameters.act;
    }

    delete() {
    }

    public boolean onEntry(Object state, Map<String,Object> opaqueData) {
        //should add a type checker here but still don't know how ?
        PrinterAction pa = (PrinterAction)parameters.state;
        log "Checking : " + pa.actionP + " == " + targetAction;
        return pa.actionP.equals(targetAction);
    }
}

/**
 * Callback to find a specific action by sequence ID
 */
public concept FindSequenceId extends OnEntryCallback {
    private Integer targetId;

    create(int id) {
        this.targetId = parameters.id;
    }

    delete() {
    }

    public boolean onEntry(Object state, Map<String,Object> opaqueData) {
        //should add a type checker here but still don't know how ?
        PrinterAction pa = (PrinterAction)parameters.state;
        return pa.sequenceId.equals(targetId);
    }
}

//========================================================================================================================================
/**
 * Sort printer actions by sequence ID using selection sort
 */
public List<PrinterAction> sortPrinterActions(List<PrinterAction> inputList) {
    // 1. Create a result list
    List<PrinterAction> sortedList = new ArrayList<>();

    // 2. Create a temporary copy of the input list
    List<PrinterAction> tempSource = new ArrayList<>();
    for (PrinterAction p : parameters.inputList) {
        tempSource.add(p);
    }

    // 3. Selection Sort (Find Minimum and Move)
    while (tempSource.size() > 0) {
        PrinterAction smallestAction = null;

        // Find the item with the lowest sequenceId
        for (PrinterAction candidate : tempSource) {
            if (smallestAction == null) {
                smallestAction = candidate;
            }
            else {
                if (candidate.sequenceId.compareTo(smallestAction.sequenceId) < 0) {
                    smallestAction = candidate;
                }
            }
        }

        // 4. Move the smallest item we found
        sortedList.add(smallestAction);
        tempSource.remove(smallestAction);
    }

    return sortedList;
}
