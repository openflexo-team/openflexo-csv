            this.actionRow = parameters.row;
            this.timeStamp = this.actionRow.getCellAt(0).value;
            this.actionP = this.actionRow.getCellAt(1).value;
            this.sequenceId = this.actionRow.rowIndex+1;
            actionsInstances.add(this);
            log "" + sequenceId + ": " + actionP + "@ " + timeStamp + "";
