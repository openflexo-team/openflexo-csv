/**
 * Abstract concept representing a rooted graph structure
 */
public abstract concept RootedGraph {
abstract List<Object> roots();
abstract List<Object> neighbors(Object vertex);

create() {
}
delete() {
}
   }

/**
 * Abstract concept for executable actions
 */
public abstract concept Action {
abstract List<Object> execute(Object config);
create() {
}
delete() {
}
   }

/**
 * Abstract callback concept for state entry events
 */
public abstract concept OnEntryCallback {
abstract boolean onEntry(Object state, Map<String,Object> opaqueData);
   }


//========================================================================================================================================
/**
 * Dictionary-based implementation of RootedGraph
 */
public concept DictionaryGraph extends RootedGraph {
    private Map<Object,List<Object>> graph;
    private List<Object> roots;

    create() {
        this.graph = new HashMap<>();
        this.roots = new ArrayList<>();
    }

    create(List<Object> roots, Map<Object,List<Object>> graph) {
        this.graph = parameters.graph;
        this.roots = parameters.roots;
    }

    delete() {
    }

    public List<Object> roots() {
        List<Object> returnList = new ArrayList<>();
        for (Object root : this.roots) {
            returnList.add(root);
        }
        return returnList;
    }

    public List<Object> neighbors(Object vertex) {
        List<Object> returnList = graph.getOrDefault(parameters.vertex,new ArrayList<>());
        return returnList;
    }
    public void logRootAndNeighbors(){
        log "Logging Roots and neighbors for : ";
        List<Object> rootList = this.roots();
        List<Object> neighList = this.neighbors();

            if (rootList == null){
                log "ROOT EMPTY ";
            }
            if (neighList == null){
                log "NEIGHBORS EMPTY ";
            }


        for (Object root : rootList) {
            log "Root" + root;
        }
        for(Object nei:neighList){
            log "Neighbor" + nei;
        }

    }

}
/**
 * Wrapper for RootedGraph that tracks parent relationships during traversal
 */
public concept ParentTracer extends RootedGraph {
    private RootedGraph operand with ConceptInstance();
    private Map<Object,List<Object>> parents;

    create(RootedGraph graph) {
        this.operand = parameters.graph;
        this.parents = null; //change later with new HashMap<>();
    }

    delete() {
    }

    public List<Object> roots() {
        List<Object> roots = this.operand.roots();
        for (Object r : roots) {
            parents.put(r,new ArrayList<>());
        }
        return roots;
    }

    public List<Object> getOpRoots() {
        List<Object> res = this.operand.roots();
        return res;
    }

    public List<Object> getOpNeighbors(Object vertex) {
        List<Object> neighbors = this.operand.neighbors(parameters.vertex);
        return neighbors;
    }

    public List<Object> neighbors(Object vertex) {
        List<Object> neighbors = this.operand.neighbors(parameters.vertex);
        for (Object n : neighbors) {
            if (!parents.containsKey(n)) {
                List<Object> parentList = new ArrayList<>();
                parentList.add(parameters.vertex);
                parents.put(n,parentList);
            }
        }
        return neighbors;
    }

    public Map<Object,List<Object>> getParents() {
        return parents;
    }
}
