        public void loadPrinterLogs() {
        Integer size = logData.rows.size();
        log "logData Size = " + size;
            for (int i = 0 ; i< size  ;i++)  {
                CSVRow tmp  = logData.getRowAt(i);
                if (tmp.rowIndex > -1) {
                    log "inside here with row :" +tmp;
                    new PrinterAction(tmp);
                    log " after here ";
                }
            }
            log "Loaded " + (logData.rowCount - 1) + " printer actions";

        }
